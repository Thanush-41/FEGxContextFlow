AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REALTIME_DEPLOYMENT=
PORT=3001
CONTEXTFLOW_DB=./data/contextflow.sqlite
# Live public offer adapter; offline tests use fixtures, clearly labeled demo.
FEED_ENABLED=true
# Optional: HTTPS address reachable by the physical device.
PUBLIC_API_URL=

# Hosted deployment only; never expose the access token in a mobile bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
