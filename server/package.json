    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "^8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
